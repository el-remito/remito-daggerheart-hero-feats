{{!--
  Feat catalog. Filter rail left, feat list right, sticky point bar on top.

  The list is split across two tabs — feats still available, and the character's own
  acquired feats. Both sections are rendered up front and the filter pass displays one
  of them, so a tab switch costs no re-render. Both render the same row partial.
--}}
<div class="rdhf-catalog-layout">

    <header class="rdhf-point-bar">
        <div class="rdhf-point-figure">
            <i class="fa-solid fa-award"></i>
            <span class="rdhf-point-remaining {{#if pool.overspent}}is-overspent{{/if}}">{{pool.remaining}}</span>
            <span class="rdhf-point-of">/ {{pool.total}}</span>
            <span class="rdhf-point-label">{{localize "RDHF.points.label"}}</span>
        </div>

        {{#if isGM}}
            <div class="rdhf-point-adjust" data-tooltip="{{localize 'RDHF.points.adjustTooltip'}}">
                <button type="button" class="rdhf-icon-btn" data-action="adjustPoints" data-delta="-1">
                    <i class="fa-solid fa-minus"></i>
                </button>
                <span class="rdhf-point-adjust-value">{{numberFormat pool.adjustment sign=true}}</span>
                <button type="button" class="rdhf-icon-btn" data-action="adjustPoints" data-delta="1">
                    <i class="fa-solid fa-plus"></i>
                </button>
            </div>
        {{/if}}

        <div class="rdhf-point-spent">
            {{localize "RDHF.points.spent"}} <strong>{{pool.spent}}</strong>
            {{#if pool.free}}<span class="rdhf-point-free">(+{{pool.free}} {{localize "RDHF.points.granted"}})</span>{{/if}}
        </div>
    </header>

    <div class="rdhf-catalog-body">

        <aside class="rdhf-rail">
            <label class="rdhf-search-wrap">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="search" class="rdhf-search" autocomplete="off" spellcheck="false"
                       value="{{filters.search}}"
                       placeholder="{{localize 'RDHF.catalog.searchPlaceholder'}}">
            </label>

            <section class="rdhf-rail-section">
                <h4 class="rdhf-rail-heading">{{localize "RDHF.catalog.levelRange"}}</h4>
                <div class="rdhf-level-range">
                    <input type="number" min="1" data-filter="levelMin" value="{{filters.levelMin}}"
                           placeholder="{{localize 'RDHF.catalog.min'}}">
                    <span class="rdhf-dash">–</span>
                    <input type="number" min="1" data-filter="levelMax" value="{{filters.levelMax}}"
                           placeholder="{{localize 'RDHF.catalog.max'}}">
                </div>
            </section>

            {{!-- Eligibility sits directly under Level because the two are read
                  together: "what can I take" is a narrowing of "what is in reach".
                  This is the one place the rail deliberately departs from the GM
                  registry's order — the registry has no eligibility switch at all,
                  so the sections the two DO share stay in the same sequence. --}}
            <section class="rdhf-rail-section">
                <label class="rdhf-checkline">
                    <input type="checkbox" data-filter="eligibleOnly" {{#if filters.eligibleOnly}}checked{{/if}}>
                    <span>{{localize "RDHF.catalog.eligibleOnly"}}</span>
                </label>
            </section>

            {{#if types.length}}
                <details class="rdhf-rail-section rdhf-rail-details" data-rail="types"
                         {{#if railOpen.types}}open{{/if}}>
                    <summary class="rdhf-rail-heading">
                        <span class="rdhf-arrow">&#9654;</span>
                        {{localize "RDHF.catalog.types"}}
                    </summary>
                    {{#each types}}
                        <label class="rdhf-checkline {{#if this.hidden}}is-hidden{{/if}}"
                               {{#if this.hidden}}data-tooltip="{{localize 'RDHF.registry.withheldByType'}}"{{/if}}>
                            <input type="checkbox" data-filter="type" value="{{this.id}}"
                                   {{#if this.checked}}checked{{/if}}>
                            {{#if this.icon}}<i class="{{this.icon}}"></i>{{/if}}
                            <span>{{this.label}}</span>
                            {{#if this.hidden}}<i class="fa-solid fa-eye-slash rdhf-rail-withheld"></i>{{/if}}
                        </label>
                    {{/each}}
                </details>
            {{/if}}

            {{#if categories.length}}
                <details class="rdhf-rail-section rdhf-rail-details" data-rail="categories"
                         {{#if railOpen.categories}}open{{/if}}>
                    <summary class="rdhf-rail-heading">
                        <span class="rdhf-arrow">&#9654;</span>
                        {{localize "RDHF.catalog.categories"}}
                    </summary>
                    {{#each categories}}
                        <label class="rdhf-checkline {{#if this.hidden}}is-hidden{{/if}}"
                               {{#if this.hidden}}data-tooltip="{{localize 'RDHF.registry.withheldByCategory'}}"{{/if}}>
                            <input type="checkbox" data-filter="category" value="{{this.id}}"
                                   {{#if this.checked}}checked{{/if}}>
                            {{#if this.icon}}<i class="{{this.icon}}"></i>{{/if}}
                            <span>{{this.label}}</span>
                            {{#if this.hidden}}<i class="fa-solid fa-eye-slash rdhf-rail-withheld"></i>{{/if}}
                        </label>
                    {{/each}}
                </details>
            {{/if}}

            {{!-- Appended after Category in BOTH windows, so the sections the two
                  share stay in the same sequence. --}}
            <section class="rdhf-rail-section">
                <label class="rdhf-checkline">
                    <input type="checkbox" data-filter="newOnly" {{#if filters.newOnly}}checked{{/if}}>
                    <span>{{localize "RDHF.catalog.newOnly"}}</span>
                </label>
            </section>

            <footer class="rdhf-rail-footer">
                <span class="rdhf-result-summary">
                    <strong class="rdhf-result-count">0</strong>
                    {{localize "RDHF.catalog.shown"}}
                </span>
                <button type="button" class="rdhf-text-btn" data-action="clearFilters">
                    {{localize "RDHF.catalog.clearFilters"}}
                </button>
            </footer>
        </aside>

        <section class="rdhf-list-pane">
            <nav class="rdhf-tabs rdhf-tabs--catalog">
                <button type="button" class="rdhf-tab {{#if isAvailableTab}}is-active{{/if}}"
                        data-action="selectTab" data-tab="available">
                    <i class="fa-solid fa-list"></i> {{localize "RDHF.catalog.tabs.available"}}
                </button>
                <button type="button" class="rdhf-tab {{#if isAcquiredTab}}is-active{{/if}}"
                        data-action="selectTab" data-tab="acquired">
                    <i class="fa-solid fa-award"></i> {{localize "RDHF.catalog.tabs.acquired"}}
                    {{#if acquiredCount}}<span class="rdhf-tab-badge rdhf-tab-badge--count">{{acquiredCount}}</span>{{/if}}
                </button>
                <button type="button" class="rdhf-tab {{#if isInvestmentsTab}}is-active{{/if}}"
                        data-action="selectTab" data-tab="investments">
                    <i class="fa-solid fa-layer-group"></i> {{localize "RDHF.catalog.tabs.investments"}}
                </button>
            </nav>

            {{#if hasFeats}}
                {{!-- Both tabs are rendered at once; _applyFilters shows one of them.
                      Switching tabs must never re-render, or the rail resets. --}}
                <section class="rdhf-section" data-section="available">
                    <ul class="rdhf-feat-list">
                        {{#each available}}
                            {{> "modules/remito-daggerheart-hero-feats/templates/partials/feat-row.hbs"}}
                        {{/each}}
                    </ul>
                </section>

                <section class="rdhf-section" data-section="acquired" hidden>
                    <ul class="rdhf-feat-list">
                        {{#each acquired}}
                            {{> "modules/remito-daggerheart-hero-feats/templates/partials/feat-row.hbs"}}
                        {{/each}}
                    </ul>
                </section>

                {{!-- A per-Category summary rather than a Feat list, which is why
                      _applyFilters hides the rail while it is showing and counts no
                      rows for it. --}}
                <section class="rdhf-section" data-section="investments" hidden>
                    {{#if investments.length}}
                        <p class="rdhf-hint">{{localize "RDHF.catalog.investmentsHint"}}</p>
                        <ul class="rdhf-invest-list">
                            {{#each investments}}
                                <li class="rdhf-invest">
                                    <div class="rdhf-invest-head">
                                        <span class="rdhf-invest-name">{{this.label}}</span>
                                        <span class="rdhf-chip rdhf-chip--owned">
                                            {{localize "RDHF.catalog.investedCount" count=this.invested}}
                                        </span>
                                    </div>
                                    {{#if this.tiers.length}}
                                        <ul class="rdhf-invest-tiers">
                                            {{#each this.tiers}}
                                                <li class="rdhf-invest-tier">
                                                    <span class="rdhf-invest-when">
                                                        {{#if @first}}
                                                            {{localize "RDHF.catalog.investNext"}}
                                                        {{else}}
                                                            {{localize "RDHF.catalog.investThen"}}
                                                        {{/if}}
                                                    </span>
                                                    <span class="rdhf-bar">
                                                        <span class="rdhf-bar-fill" style="width: {{this.share}}%"></span>
                                                    </span>
                                                    <span class="rdhf-invest-at">
                                                        {{this.have}}&thinsp;/&thinsp;{{this.required}}
                                                    </span>
                                                    <span class="rdhf-invest-need">
                                                        {{localize "RDHF.catalog.investMore" count=this.more}}
                                                    </span>
                                                    <span class="rdhf-invest-opens">
                                                        {{localize "RDHF.catalog.investUnlocks" count=this.unlocks}}
                                                    </span>
                                                </li>
                                            {{/each}}
                                        </ul>
                                    {{else}}
                                        <p class="rdhf-invest-done">{{localize "RDHF.catalog.investNone"}}</p>
                                    {{/if}}
                                </li>
                            {{/each}}
                        </ul>
                    {{else}}
                        <p class="rdhf-empty">{{localize "RDHF.catalog.noInvestments"}}</p>
                    {{/if}}
                </section>

                <p class="rdhf-empty" data-empty="available" hidden>{{localize "RDHF.catalog.noMatches"}}</p>
                <p class="rdhf-empty" data-empty="acquired" hidden>{{localize "RDHF.catalog.noAcquired"}}</p>
            {{else}}
                <p class="rdhf-empty">{{localize "RDHF.catalog.noFeats"}}</p>
            {{/if}}
        </section>
    </div>
</div>
