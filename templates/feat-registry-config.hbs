{{!--
  GM Feat Registry. Seven tabs; the whole window is also a drop target for individual
  Feature items (bound by hand in _onRender — ApplicationV2 has no dragDrop option).
--}}
<div class="rdhf-registry-layout">

    <nav class="rdhf-tabs">
        <button type="button" class="rdhf-tab {{#if isSources}}is-active{{/if}}" data-action="selectTab" data-tab="sources">
            <i class="fa-solid fa-box-archive"></i> {{localize "RDHF.registry.tabs.sources"}}
        </button>
        <button type="button" class="rdhf-tab {{#if isFeats}}is-active{{/if}}" data-action="selectTab" data-tab="feats">
            <i class="fa-solid fa-list-check"></i> {{localize "RDHF.registry.tabs.feats"}}
        </button>
        <button type="button" class="rdhf-tab {{#if isCuration}}is-active{{/if}}" data-action="selectTab" data-tab="curation">
            <i class="fa-solid fa-wand-magic-sparkles"></i> {{localize "RDHF.registry.tabs.curation"}}
            {{!-- The uncurated count lives here rather than on Feats: it is a call to
                  action, and this is the tab that answers it. Painted by _paintBadges(),
                  which writes every badge in the nav rather than the first one. --}}
            <span class="rdhf-tab-badge" {{#unless uncuratedCount}}hidden{{/unless}}>{{uncuratedCount}}</span>
        </button>
        <button type="button" class="rdhf-tab {{#if isTaxonomy}}is-active{{/if}}" data-action="selectTab" data-tab="taxonomy">
            <i class="fa-solid fa-tags"></i> {{localize "RDHF.registry.tabs.taxonomy"}}
        </button>
        <button type="button" class="rdhf-tab {{#if isPoints}}is-active{{/if}}" data-action="selectTab" data-tab="points">
            <i class="fa-solid fa-calculator"></i> {{localize "RDHF.registry.tabs.points"}}
        </button>
        <button type="button" class="rdhf-tab {{#if isAutomation}}is-active{{/if}}" data-action="selectTab" data-tab="automation">
            <i class="fa-solid fa-robot"></i> {{localize "RDHF.registry.tabs.automation"}}
        </button>
        {{#if showStats}}
            <button type="button" class="rdhf-tab {{#if isStats}}is-active{{/if}}" data-action="selectTab" data-tab="stats">
                <i class="fa-solid fa-chart-simple"></i> {{localize "RDHF.registry.tabs.stats"}}
            </button>
        {{/if}}
    </nav>

    {{!-- The Feats tab is a two-column grid whose list scrolls on its own; every
          other tab scrolls as one block. rdhf-reg-scroll marks whichever element is
          the real scroller, so scroll position survives a re-render either way. --}}
    <div class="rdhf-registry-body {{#if isFeats}}is-split{{else}}{{#if isCuration}}is-split{{else}}rdhf-reg-scroll{{/if}}{{/if}}">

        {{#if isSources}}
            <section class="rdhf-pane">
                <p class="rdhf-hint">{{localize "RDHF.registry.sourcesHint"}}</p>

                {{!-- Filters both lists below in place. Its value is held on the app,
                      so adding a pack or dropping a Feature does not clear it. --}}
                <label class="rdhf-search-wrap">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <input type="search" class="rdhf-source-search" autocomplete="off" spellcheck="false"
                           value="{{sourceSearch}}"
                           placeholder="{{localize 'RDHF.registry.sourceSearchPlaceholder'}}">
                </label>

                <div class="rdhf-add-row">
                    <select class="rdhf-pack-select">
                        <option value="">{{localize "RDHF.registry.choosePack"}}</option>
                        {{#each availablePacks}}
                            <option value="{{this.id}}">{{this.label}}</option>
                        {{/each}}
                    </select>
                    <button type="button" class="rdhf-text-btn" data-action="addSource">
                        <i class="fa-solid fa-plus"></i> {{localize "RDHF.registry.addSource"}}
                    </button>
                </div>

                {{#if sources.length}}
                    <ul class="rdhf-source-list">
                        {{#each sources}}
                            <li class="rdhf-source {{#if this.missing}}is-missing{{/if}}"
                                data-source-search="{{this.searchText}}">
                                <i class="fa-solid fa-box-archive"></i>
                                <span class="rdhf-source-label">{{this.label}}</span>
                                <code class="rdhf-source-id">{{this.packId}}</code>
                                {{#if this.missing}}
                                    <span class="rdhf-chip rdhf-chip--unmet">{{localize "RDHF.registry.packMissing"}}</span>
                                {{/if}}
                                <button type="button" class="rdhf-icon-btn rdhf-danger"
                                        data-action="removeSource" data-pack-id="{{this.packId}}"
                                        data-tooltip="{{localize 'RDHF.registry.removeSource'}}">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </li>
                        {{/each}}
                    </ul>
                    <p class="rdhf-source-empty rdhf-empty" hidden>{{localize "RDHF.registry.noMatches"}}</p>
                {{else}}
                    <p class="rdhf-empty">{{localize "RDHF.registry.noSources"}}</p>
                {{/if}}

                <div class="rdhf-dropzone">
                    <i class="fa-solid fa-hand-pointer"></i>
                    <p>{{localize "RDHF.registry.dropHint"}}</p>
                </div>

                <h4 class="rdhf-rail-heading">{{localize "RDHF.registry.standalone"}}</h4>
                <p class="rdhf-hint">{{localize "RDHF.registry.standaloneHint"}}</p>
                {{#if standaloneFeats.length}}
                    <ul class="rdhf-source-list">
                        {{#each standaloneFeats}}
                            <li class="rdhf-source" data-uuid="{{this.uuid}}"
                                data-source-search="{{this.searchText}}">
                                <img class="rdhf-feat-img rdhf-feat-img--small" src="{{this.img}}" alt="">
                                <span class="rdhf-source-label">{{this.name}}</span>
                                <code class="rdhf-source-id">{{this.uuid}}</code>
                                {{#if this.uncurated}}
                                    <span class="rdhf-chip rdhf-chip--uncurated">{{localize "RDHF.catalog.uncurated"}}</span>
                                {{/if}}
                                <button type="button" class="rdhf-icon-btn rdhf-danger"
                                        data-action="removeFeat"
                                        data-tooltip="{{localize 'RDHF.registry.removeStandalone'}}">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </li>
                        {{/each}}
                    </ul>
                    <p class="rdhf-source-empty rdhf-empty" hidden>{{localize "RDHF.registry.noMatches"}}</p>
                {{else}}
                    <p class="rdhf-empty">{{localize "RDHF.registry.noStandalone"}}</p>
                {{/if}}
            </section>
        {{/if}}

        {{#if isFeats}}
            {{!-- Deliberately mirrors the player catalog: same rail, same row shape,
                  same matchesFilters predicate. The GM should be curating against the
                  view the table actually sees. Player-only switches (eligibility,
                  hide-acquired) have no meaning here and are left out; "uncurated only"
                  is the curation tool that replaces them. --}}
            <section class="rdhf-pane rdhf-pane--split">
                <aside class="rdhf-rail">
                    <label class="rdhf-search-wrap">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <input type="search" class="rdhf-reg-search" autocomplete="off" spellcheck="false"
                               value="{{filters.search}}"
                               placeholder="{{localize 'RDHF.registry.searchPlaceholder'}}">
                    </label>

                    <section class="rdhf-rail-section">
                        <h4 class="rdhf-rail-heading">{{localize "RDHF.catalog.levelRange"}}</h4>
                        <div class="rdhf-level-range">
                            <input type="number" min="1" data-filter="levelMin" value="{{filters.levelMin}}"
                                   placeholder="{{localize 'RDHF.catalog.min'}}">
                            <span class="rdhf-dash">&ndash;</span>
                            <input type="number" min="1" data-filter="levelMax" value="{{filters.levelMax}}"
                                   placeholder="{{localize 'RDHF.catalog.max'}}">
                        </div>
                    </section>

                    {{#if filterTypes.length}}
                        <details class="rdhf-rail-section rdhf-rail-details" data-rail="types"
                                 {{#if railOpen.types}}open{{/if}}>
                            <summary class="rdhf-rail-heading">
                                <span class="rdhf-arrow">&#9654;</span>
                                {{localize "RDHF.catalog.types"}}
                            </summary>
                            {{#each filterTypes}}
                                <label class="rdhf-checkline">
                                    <input type="checkbox" data-filter="type" value="{{this.id}}"
                                           {{#if this.checked}}checked{{/if}}>
                                    {{#if this.icon}}<i class="{{this.icon}}"></i>{{/if}}
                                    <span>{{this.label}}</span>
                                </label>
                            {{/each}}
                        </details>
                    {{/if}}

                    {{#if filterCategories.length}}
                        <details class="rdhf-rail-section rdhf-rail-details" data-rail="categories"
                                 {{#if railOpen.categories}}open{{/if}}>
                            <summary class="rdhf-rail-heading">
                                <span class="rdhf-arrow">&#9654;</span>
                                {{localize "RDHF.catalog.categories"}}
                            </summary>
                            {{#each filterCategories}}
                                <label class="rdhf-checkline">
                                    <input type="checkbox" data-filter="category" value="{{this.id}}"
                                           {{#if this.checked}}checked{{/if}}>
                                    {{#if this.icon}}<i class="{{this.icon}}"></i>{{/if}}
                                    <span>{{this.label}}</span>
                                </label>
                            {{/each}}
                        </details>
                    {{/if}}

                    <section class="rdhf-rail-section">
                        <label class="rdhf-checkline">
                            <input type="checkbox" data-filter="uncuratedOnly" {{#if uncuratedOnly}}checked{{/if}}>
                            <span>{{localize "RDHF.registry.uncuratedOnly"}}</span>
                        </label>
                        <label class="rdhf-checkline">
                            <input type="checkbox" data-filter="hiddenOnly" {{#if hiddenOnly}}checked{{/if}}>
                            <span>{{localize "RDHF.registry.hiddenOnly"}}</span>
                        </label>
                    </section>

                    <footer class="rdhf-rail-footer">
                        <span class="rdhf-result-summary">
                            <strong class="rdhf-reg-count">{{featCount}}</strong>
                            {{localize "RDHF.catalog.shown"}}
                        </span>
                        <button type="button" class="rdhf-text-btn" data-action="clearRegFilters">
                            {{localize "RDHF.catalog.clearFilters"}}
                        </button>
                        <button type="button" class="rdhf-text-btn" data-action="pruneOrphans">
                            <i class="fa-solid fa-broom"></i> {{localize "RDHF.registry.prune"}}
                        </button>
                        <button type="button" class="rdhf-text-btn" data-action="resyncAll"
                                data-tooltip="{{localize 'RDHF.registry.resyncAllTooltip'}}">
                            <i class="fa-solid fa-arrows-rotate"></i> {{localize "RDHF.registry.resyncAll"}}
                        </button>
                    </footer>
                </aside>

                <section class="rdhf-list-pane rdhf-reg-scroll">
                {{#if feats.length}}
                    <ul class="rdhf-reg-list">
                        {{#each feats}}
                            <li>
                                <details class="rdhf-reg-feat {{#if this.uncurated}}is-uncurated{{/if}} {{#if this.hidden}}is-hidden{{/if}}"
                                         data-uuid="{{this.uuid}}"
                                         data-search="{{this.searchText}}"
                                         data-uncurated="{{this.uncurated}}"
                                         data-hidden="{{this.hidden}}"
                                         data-level="{{this.level}}"
                                         data-category="{{this.category}}"
                                         data-types="{{this.typesAttr}}"
                                         {{#if this.isOpen}}open{{/if}}>
                                    <summary class="rdhf-feat-summary">
                                        <span class="rdhf-arrow">&#9654;</span>
                                        <img class="rdhf-feat-img" src="{{this.img}}" alt="">

                                        <div class="rdhf-feat-main">
                                            <div class="rdhf-feat-titleline">
                                                <span class="rdhf-feat-name">{{this.name}}</span>
                                                {{!-- Everything from here to the close of
                                                      this span is rebuilt in place by
                                                      _refreshRow() as the GM edits, so the
                                                      chips never lag a re-render behind. --}}
                                                <span class="rdhf-reg-chips">
                                                <span class="rdhf-chip rdhf-chip--level">{{localize "RDHF.catalog.levelShort"}} {{this.level}}</span>
                                                {{#if this.categoryLabel}}
                                                    <span class="rdhf-chip rdhf-chip--category">{{this.categoryLabel}}</span>
                                                {{/if}}
                                                {{#each this.typeLabels}}
                                                    <span class="rdhf-chip rdhf-chip--type">{{this}}</span>
                                                {{/each}}
                                                {{#if this.uncurated}}
                                                    <span class="rdhf-chip rdhf-chip--uncurated"
                                                          data-tooltip="{{localize 'RDHF.catalog.uncuratedTooltip'}}">
                                                        {{localize "RDHF.catalog.uncurated"}}
                                                    </span>
                                                {{/if}}
                                                {{#if this.hidden}}
                                                    <span class="rdhf-chip rdhf-chip--hidden"
                                                          data-tooltip="{{localize 'RDHF.catalog.hiddenTooltip'}}">
                                                        <i class="fa-solid fa-eye-slash"></i>
                                                        {{localize "RDHF.catalog.hidden"}}
                                                    </span>
                                                {{/if}}
                                                {{#if this.standalone}}
                                                    <span class="rdhf-chip rdhf-chip--standalone"
                                                          data-tooltip="{{localize 'RDHF.registry.standaloneTooltip'}}">
                                                        <i class="fa-solid fa-hand-pointer"></i>
                                                    </span>
                                                {{/if}}
                                                {{#if this.autoExempt}}
                                                    <span class="rdhf-chip rdhf-chip--exempt"
                                                          data-tooltip="{{localize 'RDHF.registry.autoExemptTooltip'}}">
                                                        <i class="fa-solid fa-robot"></i>
                                                    </span>
                                                {{/if}}
                                                </span>
                                            </div>
                                            {{!-- Filled by _paintRequirementLine(), never
                                                  by Handlebars: the same helper has to
                                                  repaint it on every requirement edit, and
                                                  one implementation cannot drift from
                                                  itself the way this markup and _buildChips
                                                  can. Chips carry no met/unmet state — there
                                                  is no character here to measure against. --}}
                                            <div class="rdhf-req-line rdhf-reg-reqs" hidden>
                                                <span class="rdhf-req-label">{{localize "RDHF.catalog.requires"}}</span>
                                            </div>
                                            {{#if this.teaser}}
                                                <p class="rdhf-feat-teaser">{{this.teaser}}</p>
                                            {{/if}}
                                        </div>

                                        <div class="rdhf-feat-controls">
                                            <button type="button" class="rdhf-icon-btn"
                                                    data-action="resyncFeat"
                                                    data-tooltip="{{localize 'RDHF.registry.resyncFeatTooltip'}}">
                                                <i class="fa-solid fa-arrows-rotate"></i>
                                            </button>
                                            {{#if this.registered}}
                                                <button type="button" class="rdhf-icon-btn rdhf-danger"
                                                        data-action="resetFeat"
                                                        data-tooltip="{{localize 'RDHF.registry.resetFeat'}}">
                                                    <i class="fa-solid fa-rotate-left"></i>
                                                </button>
                                            {{/if}}
                                        </div>
                                    </summary>

                                    <div class="rdhf-reg-form">
                                        <div class="rdhf-field-grid">
                                            <label>
                                                <span>{{localize "RDHF.registry.level"}}</span>
                                                <input type="number" min="1" data-field="level" value="{{this.level}}">
                                            </label>
                                            <label>
                                                <span>{{localize "RDHF.registry.category"}}</span>
                                                <select data-field="category">
                                                    <option value="">{{localize "RDHF.registry.noCategory"}}</option>
                                                    {{#each this.categoryOptions}}
                                                        <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
                                                    {{/each}}
                                                </select>
                                            </label>
                                        </div>

                                        <label class="rdhf-checkline rdhf-checkline--boxed">
                                            <input type="checkbox" data-field="hidden" {{#if this.hidden}}checked{{/if}}>
                                            <span>{{localize "RDHF.registry.hidden"}}</span>
                                        </label>
                                        <p class="rdhf-hint">{{localize "RDHF.registry.hiddenHint"}}</p>

                                        <label class="rdhf-checkline rdhf-checkline--boxed">
                                            <input type="checkbox" data-field="autoExempt" {{#if this.autoExempt}}checked{{/if}}>
                                            <span>{{localize "RDHF.registry.autoExempt"}}</span>
                                        </label>
                                        <p class="rdhf-hint">{{localize "RDHF.registry.autoExemptHint"}}</p>

                                        <label class="rdhf-block-field">
                                            <span>{{localize "RDHF.registry.summary"}}</span>
                                            <textarea class="rdhf-wide" rows="2" data-field="summary"
                                                      placeholder="{{this.autoSummary}}">{{this.summaryText}}</textarea>
                                        </label>
                                        <p class="rdhf-hint">{{localize "RDHF.registry.summaryHint"}}</p>

                                        {{!-- The placeholder showing the auto-summary
                                              disappears the moment the GM types, so the
                                              source text needs a home of its own. Loaded
                                              lazily on first open. --}}
                                        <details class="rdhf-desc-panel">
                                            <summary class="rdhf-desc-summary">
                                                <span class="rdhf-arrow">&#9654;</span>
                                                {{localize "RDHF.registry.fullDescription"}}
                                            </summary>
                                            <div class="rdhf-desc-body" data-loaded="false">
                                                <p class="rdhf-loading">{{localize "RDHF.catalog.loading"}}</p>
                                            </div>
                                        </details>

                                        <fieldset class="rdhf-fieldset">
                                            <legend>{{localize "RDHF.registry.types"}}</legend>
                                            <div class="rdhf-chip-grid">
                                                {{#each this.typeOptions}}
                                                    <label class="rdhf-checkline">
                                                        <input type="checkbox" data-field="type" value="{{this.id}}" {{#if this.checked}}checked{{/if}}>
                                                        <span>{{this.label}}</span>
                                                    </label>
                                                {{/each}}
                                            </div>
                                        </fieldset>

                                        <fieldset class="rdhf-fieldset">
                                            <legend>{{localize "RDHF.registry.requirements"}}</legend>

                                            <h5 class="rdhf-sub">{{localize "RDHF.registry.traits"}}</h5>
                                            <div class="rdhf-mini-grid">
                                                {{#each this.traitRows}}
                                                    <label>
                                                        <span>{{this.label}}</span>
                                                        <input type="number" min="0" data-field="trait" data-key="{{this.key}}" value="{{this.value}}">
                                                    </label>
                                                {{/each}}
                                            </div>

                                            <h5 class="rdhf-sub">{{localize "RDHF.registry.resources"}}</h5>
                                            <p class="rdhf-hint">{{localize "RDHF.registry.resourcesHint"}}</p>
                                            <div class="rdhf-mini-grid">
                                                {{#each this.resourceRows}}
                                                    <label>
                                                        <span>{{this.label}}</span>
                                                        <input type="number" min="0" data-field="resource" data-key="{{this.key}}" value="{{this.value}}">
                                                    </label>
                                                {{/each}}
                                            </div>

                                            <h5 class="rdhf-sub">{{localize "RDHF.registry.otherFeats"}}</h5>
                                            <p class="rdhf-hint">{{localize "RDHF.registry.featuresDropHint"}}</p>
                                            {{!-- The chips and the search ARE the
                                                  interface. The comma-separated list is
                                                  still the single source of truth, but a
                                                  UUID is unreadable, so it is demoted to
                                                  the collapsed panel at the bottom. --}}
                                            <div class="rdhf-ref-block">
                                                {{!-- Search, not another data-field: the
                                                      results list is built and the pick
                                                      written back by _bindReferenceSearch(),
                                                      so this box never syncs anything. --}}
                                                <div class="rdhf-ref-search">
                                                    <i class="fa-solid fa-magnifying-glass"></i>
                                                    <input type="text" class="rdhf-ref-search-input" autocomplete="off"
                                                           placeholder="{{localize 'RDHF.registry.featureSearchPlaceholder'}}">
                                                    <ul class="rdhf-ref-results" hidden></ul>
                                                </div>

                                                {{!-- Filled by _renderReferenceChips(). --}}
                                                <div class="rdhf-ref-chips"></div>

                                                <details class="rdhf-ref-raw">
                                                    <summary>
                                                        <span class="rdhf-arrow">&#9654;</span>
                                                        {{localize "RDHF.registry.editRawList"}}
                                                    </summary>
                                                    <input type="text" class="rdhf-wide rdhf-droppable" data-field="features"
                                                           value="{{this.featuresText}}"
                                                           placeholder="{{localize 'RDHF.registry.featuresPlaceholder'}}">
                                                </details>
                                            </div>

                                            <div class="rdhf-field-grid">
                                                <label>
                                                    <span>{{localize "RDHF.registry.classes"}}</span>
                                                    <input type="text" data-field="classes" value="{{this.classesText}}">
                                                </label>
                                                <label>
                                                    <span>{{localize "RDHF.registry.subclasses"}}</span>
                                                    <input type="text" data-field="subclasses" value="{{this.subclassesText}}">
                                                </label>
                                            </div>

                                            <h5 class="rdhf-sub">{{localize "RDHF.registry.investment"}}</h5>
                                            <p class="rdhf-hint">{{localize "RDHF.registry.investmentHint"}}</p>
                                            {{!-- Filled by _paintAutoInvestment(). Outside
                                                  the list below, which _renderInvestment
                                                  rebuilds wholesale. --}}
                                            <p class="rdhf-auto-invest" hidden></p>
                                            {{!-- Rows are built by _renderInvestment().
                                                  Adding one used to re-render the whole
                                                  window, which threw the GM back to the
                                                  top of the list. --}}
                                            <div class="rdhf-investment-list"></div>
                                            <button type="button" class="rdhf-text-btn" data-action="addInvestment">
                                                <i class="fa-solid fa-plus"></i> {{localize "RDHF.registry.addInvestment"}}
                                            </button>

                                            <h5 class="rdhf-sub">{{localize "RDHF.registry.expression"}}</h5>
                                            <p class="rdhf-hint">{{localize "RDHF.registry.expressionHint"}}</p>
                                            {{!-- The atom shortcut row is appended here by
                                                  FeatRegistryConfig._renderAtomRows(). --}}
                                            <input type="text" class="rdhf-wide" data-field="expression" value="{{this.expression}}">
                                        </fieldset>
                                    </div>
                                </details>
                            </li>
                        {{/each}}
                    </ul>
                    <p class="rdhf-reg-empty rdhf-empty" hidden>{{localize "RDHF.registry.noMatches"}}</p>
                {{else}}
                    <p class="rdhf-empty">{{localize "RDHF.registry.noFeats"}}</p>
                {{/if}}
                </section>
            </section>
        {{/if}}

        {{#if isCuration}}
            {{!-- Two panes: the queue on the left, one feat's editor on the right.
                  Both scroll independently. Selecting a feat DOES re-render — the pane
                  is a whole form and rebuilding it by hand would duplicate every
                  control the Feats tab already declares — so the queue's scroll
                  position is captured and restored around it. --}}
            <section class="rdhf-pane--split rdhf-curation">

                <aside class="rdhf-cur-queue">
                    <header class="rdhf-cur-head">
                        <h4 class="rdhf-rail-heading">{{localize "RDHF.registry.tabs.curation"}}</h4>
                        <p class="rdhf-cur-counts">
                            <span class="rdhf-cur-outstanding">{{curation.outstanding}}</span>
                            {{localize "RDHF.curation.outstanding"}}
                            <span class="rdhf-cur-ready" {{#unless curation.ready}}hidden{{/unless}}>&middot; {{localize "RDHF.curation.readyCount" count=curation.ready}}</span>
                            {{#if curation.filed}}
                                <span class="rdhf-cur-filed">&middot; {{localize "RDHF.curation.filedCount" count=curation.filed}}</span>
                            {{/if}}
                        </p>
                    </header>

                    <div class="rdhf-cur-queue-scroll">
                        {{#if curation.hasQueue}}
                            <ul class="rdhf-cur-list">
                                {{#each curation.queue}}
                                    <li>
                                        <button type="button"
                                                class="rdhf-cur-row {{#if this.isCurrent}}is-current{{/if}} {{#if this.uncurated}}is-uncurated{{/if}}"
                                                data-action="curationSelect"
                                                data-uuid="{{this.uuid}}"
                                                data-uncurated="{{this.uncurated}}">
                                            <img class="rdhf-feat-img rdhf-feat-img--small" src="{{this.img}}" alt="">
                                            <span class="rdhf-cur-row-main">
                                                <span class="rdhf-cur-row-name">{{this.name}}</span>
                                                <span class="rdhf-cur-row-chips">
                                                    <span class="rdhf-chip rdhf-chip--level rdhf-cur-row-level">{{localize "RDHF.catalog.levelShort"}} {{this.level}}</span>
                                                    <span class="rdhf-chip rdhf-chip--category rdhf-cur-row-category"
                                                          {{#unless this.categoryLabel}}hidden{{/unless}}>{{this.categoryLabel}}</span>
                                                </span>
                                            </span>
                                        </button>
                                    </li>
                                {{/each}}
                            </ul>
                        {{else}}
                            <p class="rdhf-empty">{{localize "RDHF.curation.queueEmpty"}}</p>
                        {{/if}}
                    </div>
                </aside>

                <section class="rdhf-cur-pane rdhf-reg-scroll">
                {{#if curation.feat}}
                    {{#with curation.feat}}
                    {{!-- rdhf-cur-editor is the hook _onRender uses to wire this pane
                          with exactly the helpers a Feats row gets, and data-uuid is
                          what _syncField routes every control below into. --}}
                    <div class="rdhf-cur-editor" data-uuid="{{this.uuid}}">

                        <header class="rdhf-cur-title">
                            <img class="rdhf-feat-img" src="{{this.img}}" alt="">
                            <div class="rdhf-cur-title-main">
                                <h3>{{this.name}}</h3>
                                <span class="rdhf-cur-position">{{localize "RDHF.curation.position" position=@root.curation.position total=@root.curation.total}}</span>
                            </div>
                        </header>

                        <div class="rdhf-cur-form">
                            <div class="rdhf-field-grid">
                                <label>
                                    <span>{{localize "RDHF.registry.level"}}</span>
                                    <input type="number" min="1" data-field="level" value="{{this.level}}">
                                </label>
                                <label>
                                    <span>{{localize "RDHF.registry.category"}}</span>
                                    <select data-field="category">
                                        <option value="">{{localize "RDHF.registry.noCategory"}}</option>
                                        {{#each this.categoryOptions}}
                                            <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
                                        {{/each}}
                                    </select>
                                </label>
                            </div>

                            <fieldset class="rdhf-fieldset">
                                <legend>{{localize "RDHF.registry.types"}}</legend>
                                <div class="rdhf-chip-grid">
                                    {{#each this.typeOptions}}
                                        <label class="rdhf-checkline">
                                            <input type="checkbox" data-field="type" value="{{this.id}}" {{#if this.checked}}checked{{/if}}>
                                            <span>{{this.label}}</span>
                                        </label>
                                    {{/each}}
                                </div>
                            </fieldset>

                            {{!-- Short above Full, and the full text is open from the
                                  start rather than folded away: reading the description
                                  IS how the teaser gets written, so it has to be on
                                  screen while the box above it is typed into. --}}
                            <fieldset class="rdhf-fieldset">
                                <legend>{{localize "RDHF.registry.summary"}}</legend>
                                <textarea class="rdhf-wide" rows="2" data-field="summary"
                                          placeholder="{{this.autoSummary}}">{{this.summaryText}}</textarea>
                                <p class="rdhf-hint">{{localize "RDHF.registry.summaryHint"}}</p>

                                {{!-- Kept as a details so _loadFullDescription's toggle
                                      wiring and its data-loaded guard apply unchanged. --}}
                                <details class="rdhf-desc-panel rdhf-cur-desc" open>
                                    <summary class="rdhf-desc-summary">
                                        <span class="rdhf-arrow">&#9654;</span>
                                        {{localize "RDHF.registry.fullDescription"}}
                                    </summary>
                                    <div class="rdhf-desc-body" data-loaded="false">
                                        <p class="rdhf-loading">{{localize "RDHF.catalog.loading"}}</p>
                                    </div>
                                </details>
                            </fieldset>

                            <fieldset class="rdhf-fieldset">
                                <legend>{{localize "RDHF.registry.requirements"}}</legend>

                                <h5 class="rdhf-sub">{{localize "RDHF.registry.otherFeats"}}</h5>
                                <p class="rdhf-hint">{{localize "RDHF.registry.featuresDropHint"}}</p>
                                <div class="rdhf-ref-block">
                                    <div class="rdhf-ref-search">
                                        <i class="fa-solid fa-magnifying-glass"></i>
                                        <input type="text" class="rdhf-ref-search-input" autocomplete="off"
                                               placeholder="{{localize 'RDHF.registry.featureSearchPlaceholder'}}">
                                        <ul class="rdhf-ref-results" hidden></ul>
                                    </div>
                                    <div class="rdhf-ref-chips"></div>
                                    <details class="rdhf-ref-raw">
                                        <summary>
                                            <span class="rdhf-arrow">&#9654;</span>
                                            {{localize "RDHF.registry.editRawList"}}
                                        </summary>
                                        <input type="text" class="rdhf-wide rdhf-droppable" data-field="features"
                                               value="{{this.featuresText}}"
                                               placeholder="{{localize 'RDHF.registry.featuresPlaceholder'}}">
                                    </details>
                                </div>

                                <h5 class="rdhf-sub">{{localize "RDHF.registry.traits"}}</h5>
                                <div class="rdhf-mini-grid">
                                    {{#each this.traitRows}}
                                        <label>
                                            <span>{{this.label}}</span>
                                            <input type="number" min="0" data-field="trait" data-key="{{this.key}}" value="{{this.value}}">
                                        </label>
                                    {{/each}}
                                </div>

                                <h5 class="rdhf-sub">{{localize "RDHF.registry.investment"}}</h5>
                                <p class="rdhf-hint">{{localize "RDHF.registry.investmentHint"}}</p>
                                <p class="rdhf-auto-invest" hidden></p>
                                {{!-- Rows are built by _renderInvestment(). --}}
                                <div class="rdhf-investment-list"></div>
                                <button type="button" class="rdhf-text-btn" data-action="addInvestment">
                                    <i class="fa-solid fa-plus"></i> {{localize "RDHF.registry.addInvestment"}}
                                </button>
                            </fieldset>

                            {{!-- Everything not set on most feats. Present, so a feat
                                  that needs one does not cost a tab switch; folded away,
                                  so it is not in the way of the eight that are. --}}
                            <details class="rdhf-cur-more" {{#if @root.curation.moreOpen}}open{{/if}}>
                                <summary>
                                    <span class="rdhf-arrow">&#9654;</span>
                                    {{localize "RDHF.curation.more"}}
                                </summary>

                                <label class="rdhf-checkline rdhf-checkline--boxed">
                                    <input type="checkbox" data-field="hidden" {{#if this.hidden}}checked{{/if}}>
                                    <span>{{localize "RDHF.registry.hidden"}}</span>
                                </label>
                                <p class="rdhf-hint">{{localize "RDHF.registry.hiddenHint"}}</p>

                                <label class="rdhf-checkline rdhf-checkline--boxed">
                                    <input type="checkbox" data-field="autoExempt" {{#if this.autoExempt}}checked{{/if}}>
                                    <span>{{localize "RDHF.registry.autoExempt"}}</span>
                                </label>
                                <p class="rdhf-hint">{{localize "RDHF.registry.autoExemptHint"}}</p>

                                <h5 class="rdhf-sub">{{localize "RDHF.registry.resources"}}</h5>
                                <p class="rdhf-hint">{{localize "RDHF.registry.resourcesHint"}}</p>
                                <div class="rdhf-mini-grid">
                                    {{#each this.resourceRows}}
                                        <label>
                                            <span>{{this.label}}</span>
                                            <input type="number" min="0" data-field="resource" data-key="{{this.key}}" value="{{this.value}}">
                                        </label>
                                    {{/each}}
                                </div>

                                <div class="rdhf-field-grid">
                                    <label>
                                        <span>{{localize "RDHF.registry.classes"}}</span>
                                        <input type="text" data-field="classes" value="{{this.classesText}}">
                                    </label>
                                    <label>
                                        <span>{{localize "RDHF.registry.subclasses"}}</span>
                                        <input type="text" data-field="subclasses" value="{{this.subclassesText}}">
                                    </label>
                                </div>

                                <h5 class="rdhf-sub">{{localize "RDHF.registry.expression"}}</h5>
                                <p class="rdhf-hint">{{localize "RDHF.registry.expressionHint"}}</p>
                                {{!-- _renderAtomRows() appends the shortcut row here. --}}
                                <input type="text" class="rdhf-wide" data-field="expression" value="{{this.expression}}">
                            </details>
                        </div>

                        <footer class="rdhf-cur-actions">
                            <p class="rdhf-cur-file-note rdhf-hint" {{#unless this.uncurated}}hidden{{/unless}}>
                                {{localize "RDHF.curation.fileUncuratedNote"}}
                            </p>
                            <div class="rdhf-cur-buttons">
                                <button type="button" class="rdhf-text-btn" data-action="curationSkip">
                                    {{localize "RDHF.curation.skip"}} <i class="fa-solid fa-forward"></i>
                                </button>
                                <button type="button" class="rdhf-save-btn" data-action="curationFile"
                                        data-tooltip="{{localize 'RDHF.curation.fileTooltip'}}">
                                    <i class="fa-solid fa-floppy-disk"></i> {{localize "RDHF.curation.file"}}
                                </button>
                            </div>
                        </footer>
                    </div>
                    {{/with}}
                {{else}}
                    <div class="rdhf-cur-done">
                        <i class="fa-solid fa-circle-check"></i>
                        <p>{{localize "RDHF.curation.doneTitle"}}</p>
                        <p class="rdhf-hint">{{localize "RDHF.curation.doneHint"}}</p>
                    </div>
                {{/if}}
                </section>
            </section>
        {{/if}}

        {{#if isTaxonomy}}
            <section class="rdhf-pane rdhf-taxonomy">
                <div class="rdhf-taxonomy-col">
                    <h4 class="rdhf-rail-heading">{{localize "RDHF.registry.categories"}}</h4>
                    <p class="rdhf-hint">{{localize "RDHF.registry.categoriesHint"}}</p>
                    {{#each categories}}
                        <div class="rdhf-taxonomy-row {{#if this.fixed}}is-fixed{{/if}}" data-entry-id="{{this.id}}">
                            {{#if this.fixed}}
                                {{!-- General is the Category that lets a feat be curated
                                      without inventing a filing system, so it may not be
                                      renamed or deleted. Its icon is still the GM's. --}}
                                <input type="text" value="{{this.resolved}}" readonly
                                       data-tooltip="{{localize 'RDHF.registry.fixedCategoryTooltip'}}">
                            {{else}}
                                <input type="text" data-field="category.label" value="{{this.resolved}}">
                            {{/if}}
                            <input type="text" class="rdhf-icon-input" data-field="category.icon" value="{{this.icon}}"
                                   placeholder="fa-solid fa-flask">
                            {{#unless this.fixed}}
                                <button type="button" class="rdhf-icon-btn rdhf-danger" data-action="removeCategory">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            {{/unless}}
                        </div>
                    {{/each}}
                    <button type="button" class="rdhf-text-btn" data-action="addCategory">
                        <i class="fa-solid fa-plus"></i> {{localize "RDHF.registry.addCategory"}}
                    </button>
                </div>

                <div class="rdhf-taxonomy-col">
                    <h4 class="rdhf-rail-heading">{{localize "RDHF.registry.types"}}</h4>
                    <p class="rdhf-hint">{{localize "RDHF.registry.typesHint"}}</p>
                    {{#each types}}
                        <div class="rdhf-taxonomy-row" data-entry-id="{{this.id}}">
                            <input type="text" data-field="type.label" value="{{this.resolved}}">
                            <input type="text" class="rdhf-icon-input" data-field="type.icon" value="{{this.icon}}"
                                   placeholder="fa-solid fa-tag">
                            <button type="button" class="rdhf-icon-btn rdhf-danger" data-action="removeType">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        </div>
                    {{/each}}
                    <button type="button" class="rdhf-text-btn" data-action="addType">
                        <i class="fa-solid fa-plus"></i> {{localize "RDHF.registry.addType"}}
                    </button>
                </div>
            </section>
        {{/if}}

        {{#if isPoints}}
            <section class="rdhf-pane">
                <label class="rdhf-block-field">
                    <span>{{localize "RDHF.settings.pointFormula.name"}}</span>
                    <input type="text" class="rdhf-wide" data-field="pointFormula" value="{{formula}}">
                </label>
                <p class="rdhf-hint">{{localize "RDHF.settings.pointFormula.hint"}}</p>
                <p class="rdhf-formula-preview">{{formulaPreview}}</p>

                <h4 class="rdhf-rail-heading">{{localize "RDHF.registry.formulaKeys"}}</h4>
                <ul class="rdhf-key-list">
                    <li><code>@level</code> {{localize "RDHF.registry.keyLevel"}}</li>
                    <li><code>@tier</code> {{localize "RDHF.registry.keyTier"}}</li>
                    <li><code>@prof</code> {{localize "RDHF.registry.keyProf"}}</li>
                    <li><code>@system.traits.agility.value</code> {{localize "RDHF.registry.keySystem"}}</li>
                </ul>
            </section>
        {{/if}}

        {{#if isAutomation}}
            <section class="rdhf-pane">
                <p class="rdhf-hint">{{localize "RDHF.automation.intro"}}</p>

                <h4 class="rdhf-rail-heading">{{localize "RDHF.automation.investment.name"}}</h4>
                <label class="rdhf-checkline rdhf-checkline--boxed">
                    <input type="checkbox" data-field="automationEnabled" {{#if autoInvestEnabled}}checked{{/if}}>
                    <span>{{localize "RDHF.automation.investment.toggle"}}</span>
                </label>
                <p class="rdhf-hint">{{localize "RDHF.automation.investment.hint"}}</p>

                {{!-- Exemptions are stated here, on the tab that switches the rule on,
                      rather than only in the code: a GM reading this pane is deciding
                      whether to enable it, and needs to know what it will NOT touch. --}}
                <ul class="rdhf-key-list rdhf-auto-notes">
                    <li>{{localize "RDHF.automation.exempt.general"}}</li>
                    <li>{{localize "RDHF.automation.exempt.uncurated"}}</li>
                    <li>{{localize "RDHF.automation.exempt.authored"}}</li>
                    <li>{{localize "RDHF.automation.exempt.flag"}}</li>
                </ul>

                <h4 class="rdhf-rail-heading">{{localize "RDHF.automation.table"}}</h4>
                <p class="rdhf-hint">{{localize "RDHF.automation.tableHint"}}</p>
                <div class="rdhf-auto-table {{#unless autoInvestEnabled}}is-disabled{{/unless}}">
                    <div class="rdhf-auto-row rdhf-auto-row--head">
                        <span>{{localize "RDHF.automation.levelColumn"}}</span>
                        <span>{{localize "RDHF.automation.countColumn"}}</span>
                    </div>
                    {{#each automationRows}}
                        <label class="rdhf-auto-row">
                            <span>{{this.level}}</span>
                            <input type="number" min="0" step="1" data-field="automationLevel"
                                   data-level="{{this.level}}" value="{{this.count}}">
                        </label>
                    {{/each}}
                </div>
                <button type="button" class="rdhf-text-btn" data-action="resetAutomation">
                    <i class="fa-solid fa-rotate-left"></i> {{localize "RDHF.automation.reset"}}
                </button>
            </section>
        {{/if}}

        {{!-- Statistics. Everything here is DERIVED on each render from the working copy
              and the actor flags. Nothing on this tab is stored and nothing is editable.
              It reads the UNSAVED working copy deliberately, so a Category assigned a
              moment ago on the Feats tab is already reflected here. --}}
        {{#if isStats}}
            <section class="rdhf-pane rdhf-stats">
                {{#unless stats.hasFeats}}
                    <p class="rdhf-empty">{{localize "RDHF.stats.noFeats"}}</p>
                {{else}}

                <h4 class="rdhf-stats-heading">{{localize "RDHF.stats.shape"}}</h4>

                <div class="rdhf-counters">
                    <div class="rdhf-counter">
                        <strong>{{stats.catalog.total}}</strong>
                        <span>{{localize "RDHF.stats.counter.total"}}</span>
                    </div>
                    <div class="rdhf-counter">
                        <strong>{{stats.catalog.curated}}</strong>
                        <span>{{localize "RDHF.stats.counter.curated"}}</span>
                    </div>
                    <div class="rdhf-counter {{#if stats.catalog.uncurated}}is-warn{{/if}}">
                        <strong>{{stats.catalog.uncurated}}</strong>
                        <span>{{localize "RDHF.stats.counter.uncurated"}}</span>
                    </div>
                    <div class="rdhf-counter">
                        <strong>{{stats.catalog.hidden}}</strong>
                        <span>{{localize "RDHF.stats.counter.hidden"}}</span>
                    </div>
                    <div class="rdhf-counter">
                        <strong>{{stats.catalog.standalone}}</strong>
                        <span>{{localize "RDHF.stats.counter.standalone"}}</span>
                    </div>
                    <div class="rdhf-counter {{#if stats.catalog.missing}}is-bad{{/if}}">
                        <strong>{{stats.catalog.missing}}</strong>
                        <span>{{localize "RDHF.stats.counter.missing"}}</span>
                    </div>
                </div>

                {{!-- Both grids render; _onStatsAxis toggles [hidden] between them. A
                      re-render would throw a GM reading down a long tab to the top. --}}
                <div class="rdhf-axis-switch">
                    <button type="button" class="rdhf-axis-btn {{#if isAxisCategory}}is-active{{/if}}"
                            data-action="statsAxis" data-axis="category">
                        {{localize "RDHF.catalog.categories"}}
                    </button>
                    <button type="button" class="rdhf-axis-btn {{#if isAxisType}}is-active{{/if}}"
                            data-action="statsAxis" data-axis="type">
                        {{localize "RDHF.catalog.types"}}
                    </button>
                </div>
                <p class="rdhf-hint">{{localize "RDHF.stats.gridHint"}}</p>

                {{#each stats.catalog.gridList}}
                    <div class="rdhf-heat" data-axis="{{this.axis}}" {{#if this.hidden}}hidden{{/if}}>
                        <div class="rdhf-heat-scroll">
                            <table class="rdhf-heat-table">
                                <thead>
                                    <tr>
                                        <th scope="col" class="rdhf-heat-corner"></th>
                                        {{#each this.columns}}
                                            <th scope="col">{{this}}</th>
                                        {{/each}}
                                        <th scope="col" class="rdhf-heat-total">{{localize "RDHF.stats.all"}}</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {{#each this.rows}}
                                        <tr {{#if this.isUncurated}}class="is-uncurated"{{/if}}>
                                            <th scope="row" class="rdhf-heat-rowhead">
                                                {{#if this.icon}}<i class="{{this.icon}}"></i>{{/if}}
                                                <span>{{this.label}}</span>
                                            </th>
                                            {{#each this.cells}}
                                                <td class="rdhf-heat-cell {{#if this.empty}}is-empty{{/if}}"
                                                    style="--rdhf-heat: {{this.intensity}}">
                                                    <button type="button" data-action="focusCell"
                                                            data-row="{{this.rowId}}"
                                                            data-level="{{this.level}}"
                                                            data-axis="{{this.axis}}">{{this.count}}</button>
                                                </td>
                                            {{/each}}
                                            <td class="rdhf-heat-total">{{this.total}}</td>
                                        </tr>
                                    {{/each}}
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <th scope="row" class="rdhf-heat-rowhead">{{localize "RDHF.stats.all"}}</th>
                                        {{#each this.columnTotals}}
                                            <td>{{this.count}}</td>
                                        {{/each}}
                                        <td class="rdhf-heat-total"></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                {{/each}}

                <p class="rdhf-hint">
                    {{localize "RDHF.stats.typedNote"}}
                    <strong>{{stats.catalog.typed}}</strong> / <strong>{{stats.catalog.total}}</strong>
                </p>

                <h4 class="rdhf-stats-heading">{{localize "RDHF.stats.gaps"}}</h4>

                {{#if stats.catalog.gaps.emptyCategories.length}}
                    <p class="rdhf-stats-line">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                        <span>{{localize "RDHF.stats.emptyCategories"}}</span>
                        {{#each stats.catalog.gaps.emptyCategories}}
                            <span class="rdhf-chip rdhf-chip--uncurated">{{this.label}}</span>
                        {{/each}}
                    </p>
                {{/if}}

                {{#if stats.catalog.gaps.emptyLevels.length}}
                    <p class="rdhf-stats-line">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                        <span>{{localize "RDHF.stats.emptyLevels"}}</span>
                        {{#each stats.catalog.gaps.emptyLevels}}
                            <span class="rdhf-chip rdhf-chip--level">{{this}}</span>
                        {{/each}}
                    </p>
                {{/if}}

                {{#if stats.catalog.gaps.shownCells.length}}
                    <p class="rdhf-stats-line"><span>{{localize "RDHF.stats.emptyCells"}}</span></p>
                    <ul class="rdhf-gap-list">
                        {{#each stats.catalog.gaps.shownCells}}
                            <li>
                                <button type="button" class="rdhf-gap-btn" data-action="focusCell"
                                        data-row="{{this.id}}" data-level="{{this.level}}" data-axis="category">
                                    {{this.label}} &middot; {{localize "RDHF.catalog.levelShort"}} {{this.level}}
                                </button>
                            </li>
                        {{/each}}
                    </ul>
                    {{#if stats.catalog.gaps.moreCells}}
                        <p class="rdhf-hint">
                            {{stats.catalog.gaps.moreCells}} {{localize "RDHF.stats.moreCells"}}
                        </p>
                    {{/if}}
                {{else}}
                    <p class="rdhf-hint">{{localize "RDHF.stats.noGaps"}}</p>
                {{/if}}

                {{!-- Whether the Automation curve is satisfiable at all. Sits in
                      Coverage gaps rather than on the Automation tab: a shortfall is
                      answered by authoring Feats, and this is the panel about what the
                      catalog is missing. --}}
                <h5 class="rdhf-sub">{{localize "RDHF.stats.reach"}}</h5>
                {{#if stats.reach.enabled}}
                    <p class="rdhf-hint">{{localize "RDHF.stats.reachHint"}}</p>
                    {{#if stats.reach.clean}}
                        <p class="rdhf-stats-line rdhf-reach-ok">
                            <i class="fa-solid fa-circle-check"></i>
                            <span>{{localize "RDHF.stats.reachClean"}}</span>
                            <strong>{{stats.reach.checked}}</strong>
                        </p>
                    {{else}}
                        <p class="rdhf-stats-line">
                            <i class="fa-solid fa-triangle-exclamation"></i>
                            <span>{{localize "RDHF.stats.reachBlocked"}}</span>
                            <strong>{{stats.reach.blocked.length}}</strong> / <strong>{{stats.reach.checked}}</strong>
                        </p>
                        <ul class="rdhf-gap-list">
                            {{#each stats.reach.blocked}}
                                <li>
                                    <button type="button" class="rdhf-gap-btn" data-action="focusCell"
                                            data-row="{{this.category}}" data-level="{{this.level}}" data-axis="category">
                                        {{this.label}} &middot; {{localize "RDHF.catalog.levelShort"}} {{this.level}}
                                    </button>
                                    <span class="rdhf-reach-detail">
                                        {{localize "RDHF.stats.reachNeeds"}} <strong>{{this.required}}</strong>,
                                        {{localize "RDHF.stats.reachHas"}} <strong>{{this.supply}}</strong>
                                        ({{localize "RDHF.stats.reachShort"}} {{this.shortfall}})
                                    </span>
                                </li>
                            {{/each}}
                        </ul>
                    {{/if}}
                {{else}}
                    <p class="rdhf-hint">{{localize "RDHF.stats.reachOff"}}</p>
                {{/if}}

                {{#if stats.catalog.brokenReferences.length}}
                    <h5 class="rdhf-sub">{{localize "RDHF.stats.brokenRefs"}}</h5>
                    <p class="rdhf-hint">{{localize "RDHF.stats.brokenRefsHint"}}</p>
                    <ul class="rdhf-gap-list">
                        {{#each stats.catalog.brokenReferences}}
                            <li><strong>{{this.label}}</strong> <code>{{this.ref}}</code></li>
                        {{/each}}
                    </ul>
                {{/if}}

                <h5 class="rdhf-sub">{{localize "RDHF.stats.requirementUsage"}}</h5>
                <ul class="rdhf-bars">
                    {{#each stats.catalog.requirementUsage.rows}}
                        <li class="rdhf-bar-row">
                            <span class="rdhf-bar-label">{{this.label}}</span>
                            <span class="rdhf-bar">
                                <span class="rdhf-bar-fill" style="width: {{this.share}}%"></span>
                            </span>
                            <span class="rdhf-bar-value">{{this.count}}</span>
                        </li>
                    {{/each}}
                </ul>

                <h5 class="rdhf-sub">{{localize "RDHF.stats.traitDemand"}}</h5>
                <p class="rdhf-hint">{{localize "RDHF.stats.traitDemandHint"}}</p>
                <ul class="rdhf-bars">
                    {{#each stats.catalog.traitDemand.rows}}
                        <li class="rdhf-bar-row">
                            <span class="rdhf-bar-label">{{this.label}}</span>
                            <span class="rdhf-bar">
                                <span class="rdhf-bar-fill" style="width: {{this.share}}%"></span>
                            </span>
                            <span class="rdhf-bar-value">{{this.count}}</span>
                        </li>
                    {{/each}}
                </ul>

                <h5 class="rdhf-sub">{{localize "RDHF.stats.resourceDemand"}}</h5>
                <ul class="rdhf-bars">
                    {{#each stats.catalog.resourceDemand.rows}}
                        <li class="rdhf-bar-row">
                            <span class="rdhf-bar-label">{{this.label}}</span>
                            <span class="rdhf-bar">
                                <span class="rdhf-bar-fill" style="width: {{this.share}}%"></span>
                            </span>
                            <span class="rdhf-bar-value">{{this.count}}</span>
                        </li>
                    {{/each}}
                </ul>

                <h4 class="rdhf-stats-heading">{{localize "RDHF.stats.adoption"}}</h4>

                {{#unless stats.hasPlayData}}
                    <p class="rdhf-empty">{{localize "RDHF.stats.noPlayData"}}</p>
                {{else}}
                    <p class="rdhf-hint">{{localize "RDHF.stats.ledgerHint"}}</p>
                    <div class="rdhf-ledger-scroll">
                        <table class="rdhf-ledger">
                            <thead>
                                <tr>
                                    <th scope="col">{{localize "RDHF.stats.character"}}</th>
                                    <th scope="col">{{localize "RDHF.catalog.levelShort"}}</th>
                                    <th scope="col">{{localize "RDHF.stats.feats"}}</th>
                                    <th scope="col">{{localize "RDHF.stats.total"}}</th>
                                    <th scope="col">{{localize "RDHF.stats.spent"}}</th>
                                    <th scope="col">{{localize "RDHF.stats.granted"}}</th>
                                    <th scope="col">{{localize "RDHF.stats.remaining"}}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {{#each stats.adoption.characters}}
                                    <tr {{#if this.overspent}}class="is-bad"{{/if}}>
                                        <th scope="row" class="rdhf-ledger-who">
                                            {{#if this.img}}
                                                <img class="rdhf-feat-img rdhf-feat-img--small" src="{{this.img}}" alt="">
                                            {{/if}}
                                            <span>{{this.name}}</span>
                                        </th>
                                        <td>{{this.level}}</td>
                                        <td>{{this.count}}</td>
                                        <td>{{this.total}}</td>
                                        <td>{{this.spent}}</td>
                                        <td>{{this.free}}</td>
                                        <td>{{this.remaining}}</td>
                                    </tr>
                                {{/each}}
                            </tbody>
                        </table>
                    </div>

                    <h5 class="rdhf-sub">{{localize "RDHF.stats.mostTaken"}}</h5>
                    <ul class="rdhf-bars">
                        {{#each stats.adoption.popular}}
                            <li class="rdhf-bar-row">
                                <span class="rdhf-bar-label">{{this.label}}</span>
                                <span class="rdhf-bar">
                                    <span class="rdhf-bar-fill" style="width: {{this.share}}%"></span>
                                </span>
                                <span class="rdhf-bar-value">{{this.count}}</span>
                            </li>
                        {{/each}}
                    </ul>

                    <h5 class="rdhf-sub">{{localize "RDHF.stats.recent"}}</h5>
                    <ul class="rdhf-recent">
                        {{#each stats.adoption.recent}}
                            <li>
                                <span class="rdhf-recent-who">{{this.actorName}}</span>
                                <span class="rdhf-recent-what">{{this.label}}</span>
                                {{#if this.free}}
                                    <span class="rdhf-chip rdhf-chip--granted">
                                        {{localize "RDHF.catalog.granted"}}
                                    </span>
                                {{/if}}
                                <span class="rdhf-recent-when">{{this.when}}</span>
                            </li>
                        {{/each}}
                    </ul>
                {{/unless}}

                {{/unless}}
            </section>
        {{/if}}
    </div>

    <footer class="rdhf-registry-footer">
        <button type="button" class="rdhf-text-btn" data-action="exportRegistry">
            <i class="fa-solid fa-file-export"></i> {{localize "RDHF.registry.export"}}
        </button>
        <button type="button" class="rdhf-text-btn" data-action="importRegistry">
            <i class="fa-solid fa-file-import"></i> {{localize "RDHF.registry.import"}}
        </button>
        <span class="rdhf-spacer"></span>
        <button type="button" class="rdhf-save-btn" data-action="save">
            <i class="fa-solid fa-floppy-disk"></i> {{localize "RDHF.registry.save"}}
        </button>
    </footer>
</div>
